# GEO Lab environment. Copy to .env.local for local development.
# NEVER commit real values.

# Scheduler bearer token for POST /api/run (openssl rand -hex 32)
GEO_LAB_RUN_TOKEN=

# Set at seed time instead of generating a random owner password
GEO_LAB_OWNER_PASSWORD=

# Absolute path to the SQLite file (default: data/geo-lab.db)
# GEO_LAB_DB=/var/lib/geo-lab/geo-lab.db

# ── AI / search visibility providers ────────────────────────────────────────
Tavily_api_key=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Publishing ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Optional analytics / search integrations ───────────────────────────────
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GBP_OAUTH_CLIENT_ID=
BING_WEBMASTER_API_KEY=
PAGESPEED_API_KEY=
CLOUDFLARE_API_TOKEN=
