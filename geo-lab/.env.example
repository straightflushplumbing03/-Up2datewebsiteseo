# GEO Lab environment. Copy to .env.local for local development.
# NEVER commit real values.

# Scheduler bearer token for POST /api/run (openssl rand -hex 32)
GEO_LAB_RUN_TOKEN=

# Set at seed time instead of generating a random owner password
GEO_LAB_OWNER_PASSWORD=

# Absolute path to the SQLite file (default: data/geo-lab.db)
# GEO_LAB_DB=/var/lib/geo-lab/geo-lab.db

# ── AI / search visibility providers ────────────────────────────────────────
# Each key turns on that provider. None is assumed. A missing key is unmeasured, not zero.
Tavily_api_key=
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
XAI_API_KEY=
XAI_MODEL=grok-4

# Optional generative calls (not used for visibility sweeps). No default vendor.
# LLM_PROVIDER=openai
# LLM_MODEL=

# Website checkout, when the lab is not inside this repository.
# GEO_LAB_SITE_DIR=

# Notifications. Without a key, delivery is recorded as console, never as emailed.
GEO_LAB_NOTIFY_TO=
GEO_LAB_NOTIFY_CHANNEL=
GEO_LAB_MAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# ── Publishing ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Optional analytics / search integrations ───────────────────────────────
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GBP_OAUTH_CLIENT_ID=
BING_WEBMASTER_API_KEY=
PAGESPEED_API_KEY=
CLOUDFLARE_API_TOKEN=
